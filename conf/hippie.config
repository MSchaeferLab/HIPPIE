/*
 * Hard-coded Nextflow parameters for HIPPIE's ML-splits runs.
 *
 * Passed with `-c` from hippie_website/services/nextflow_runner.py, so nothing
 * in here is user-editable from the web form. The only things the task supplies
 * on the command line are --samplesheet, --outdir and -work-dir, which are
 * per-job paths.
 *
 * This file is loaded AFTER the pipeline's own nextflow.config (a `-c` file
 * always is), so every assignment below wins over the pipeline defaults in
 * conf/params.config. What it must NOT do is restate a pipeline default just to
 * look complete: a value repeated here silently stops tracking upstream.
 * Everything below is here because HIPPIE deliberately differs, or because the
 * value is load-bearing enough that an upstream change to it should be a
 * conscious HIPPIE decision too.
 */

params {
    // Only SORT_PPIS -> SOLVE_ILP -> CDHIT2D -> REMOVE_REDUNDANT ->
    // SAMPLE_NEGATIVES_ILP. FETCH_DATA / CLUSTERING / TRAIN_BASELINE / QC are
    // skipped, which is why every samplesheet row must carry the five
    // precomputed artifacts (see services/nextflow_runner.py).
    split_only               = true

    // Both are forced to "ilp" by split_only anyway (main.nf's
    // buildDatasetsChannel and PPI_SPLITTING's body). Stated explicitly so the
    // config reads as the full description of what a HIPPIE run does.
    split_method             = "ilp"
    negative_sampling_method = "ilp"

    seed                     = 42
    train_split              = 0.8
    val_split                = 0.1
    test_split               = 0.1

    ilp_epsilon              = 0.05
    // NOT a slack budget — measured, SOLVE_ILP spends all of it. The variable
    // count is small (3 x 100 booleans; z is continuous on purpose) but proving
    // optimality is not: assigning 100 unevenly-sized clusters to 3 splits
    // within +/-5% while minimising cross-split PPI loss is a hard MIP, and
    // Gurobi grinds on the bound long after it has a good incumbent. Verified
    // on a 3,000-PPI run, where it ran to the limit and returned an unproven
    // incumbent — which is the intended outcome: USER_LIMIT is in cvxpy's
    // SOLUTION_PRESENT, so the best feasible assignment is used.
    //
    // Consequence for the UI copy: every run costs roughly this much before
    // negative sampling even starts, regardless of how few interactions were
    // filtered down to. The partition's cluster count is fixed at 100, so this
    // cost does not scale with the user's filters.
    ilp_max_sec              = 1800

    cdhit_identity           = 0.4
    cdhit_wordsize           = 2

    // Gurobi, pinned explicitly on both solvers. An explicit --solver makes
    // select_solver() return Gurobi unconditionally with no fallback, so a run
    // that completes provably used Gurobi and results are comparable across
    // runs. "auto" would silently fall through to SCIP/HiGHS/CBC on a licence
    // check-out failure and produce a differently-optimised negative set under
    // the same job id.
    ilp_solver               = "GUROBI"
    neg_ilp_solver           = "gurobi"
    // WLS licence, mounted read-only into the worker container — never baked
    // into an image layer. GRB_LICENSE_FILE is what docker-compose sets; the
    // literal is the fallback for a bare `nextflow run` outside compose.
    gurobi_license           = System.getenv('GRB_LICENSE_FILE') ?: '/etc/gurobi/gurobi.lic'

    // The other half of the budget. This is where run *size* shows up: the
    // negative sampler builds one binary variable per candidate pair, so unlike
    // SOLVE_ILP above it scales with how many interactions the filters left.
    // Same USER_LIMIT behaviour — exhausting the limit returns the best feasible
    // point found with a warning rather than failing, trading solution quality
    // and not correctness.
    neg_ilp_time_limit       = 1800
    neg_ilp_mip_gap          = 0.01

    neg_ilp_lambda_degree     = 1.0
    neg_ilp_lambda_taxon_pair = 1.0
    neg_ilp_lambda_self_loop  = 1.0
    neg_ilp_lambda_jaccard    = 1.0

    // Not set: neg_ilp_max_candidates_factor. Its upstream default of 4 is
    // exactly today's hardcoded behaviour, so passing it would change nothing.
    // It is the first knob to reach for if a real run is OOM-killed — uncomment
    // and lower it (the floor is n_neg; the pool cannot be smaller than the
    // number of negatives to select from).
    // neg_ilp_max_candidates_factor = 4
}

// Clamp, do not deadlock. The pipeline's own withName: blocks ask for far more
// than this box has (SOLVE_ILP 10 cpu / 32 GB, SAMPLE_NEGATIVES_ILP 8 cpu /
// 16 GB); without resourceLimits Nextflow would refuse to schedule them at all.
//
// time is 4.h rather than 2.h because SOLVE_ILP and the three
// SAMPLE_NEGATIVES_ILP tasks each get their own 1800 s solver budget and
// withLabel:gurobi's maxForks = 2 runs the negatives in two waves — roughly
// 1800 + 2 x 1800 s of solving plus CD-HIT and I/O sits just under 2 h, and the
// per-process ceiling has to clear that with room for one error_retry attempt.
// SOLVE_ILP reaching its limit is the normal case, not the exception.
process.resourceLimits = [cpus: 2, memory: '8.GB', time: '4.h']

// resourceLimits caps what one task may ASK for. It does not cap how many run
// at once — and the local executor sizes its own pool from what it detects,
// which is the host, not the container's cgroup. Measured: inside a
// `--cpus 2 --memory 8g` container it still reported peakCpus=3 and
// peakMemory=12.GB across concurrent tasks.
//
// On a box with more cores than the worker is entitled to, that is how two
// SAMPLE_NEGATIVES_ILP tasks get scheduled side by side, each clamped to 8 GB,
// on 8 GB of RAM. Pinning the pool here is the only thing that actually bounds
// total usage; with every task clamped to the same 8 GB it also means one task
// at a time, which is the honest capacity of this machine.
executor {
    cpus   = 2
    memory = '8.GB'
}

// The pipeline's bin/*.py run under the micromamba toolchain (python 3.14.7,
// cvxpy, gurobipy, cd-hit), not under the Django runtime's python 3.11. Putting
// /opt/conda/bin on PATH here rather than in the image's global ENV is what
// keeps the two apart: Nextflow's env scope reaches task shells only, so Celery
// and Django keep resolving `python` to 3.11 and the site's own dependency set.
env {
    PATH = "/opt/conda/bin:\$PATH"
}

// Per-job work dirs are deleted on success, so the trace is the only durable
// record of what each task cost — peak_rss in particular, which is the number
// to look at if a run is ever OOM-killed. Not what the run card's step label
// reads: a trace row appears only when a task *finishes*, so a run sitting 30
// minutes inside SOLVE_ILP would report nothing. That comes from .nextflow.log
// (services/nextflow_runner.current_step).
trace {
    enabled   = true
    overwrite = true
    // Pinned: the default in Nextflow 26 is a timestamped trace-<id>.txt, which
    // no code outside the run can name.
    file      = 'trace.txt'
    fields    = 'task_id,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss'
}
