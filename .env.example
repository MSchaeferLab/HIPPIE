# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=False
# Add your real hostname here, but keep 127.0.0.1: the web container's health
# check requests http://127.0.0.1:8000/status/, and Django answers 400 for a Host
# it does not allow — which would leave the whole stack waiting on an unhealthy
# web container. This list also seeds the MCP server's Host allowlist.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# ── DIGGER handoff ──────────────────────────────────────────────────────────
# Shared secret used to sign the token DIGGER verifies. Get the real value from
# the DIGGER team; must match on both sides. Empty falls back to DJANGO_SECRET_KEY
# (fine for dev; the token won't verify against DIGGER).
HIPPIE_HANDOFF_SECRET=

# ── Database (MariaDB) ──────────────────────────────────────────────────────
# These point at the MariaDB running on the HOST machine (not a container).
# MARIADB_* are the database name + credentials of that existing host DB.
# DB_HOST=host.docker.internal lets containers reach the host's MariaDB.
# The host MariaDB must listen on the docker-gateway interface (bind-address
# 172.17.0.1) and grant the user from the container network (e.g. 'hippie'@'%').
DATABASE_ENGINE=mariadb
MARIADB_DATABASE=hippie
MARIADB_USER=hippie
MARIADB_PASSWORD=hippie
DB_HOST=host.docker.internal
DB_PORT=3306

# ── Celery / Redis ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Seconds Redis waits before re-delivering a message the worker has not acked.
# Split jobs ack late and run for hours, so this must stay above the longest
# possible run — SOLVE_ILP (4 h cap) plus two waves of negative sampling
# (4 h cap each) = 12 h. Raise it in step with `time` in conf/hippie.config.
CELERY_VISIBILITY_TIMEOUT=50400
# Django cache (browse row-count memoisation) — separate Redis DB index from Celery.
REDIS_CACHE_URL=redis://redis:6379/1

# ── Apache ──────────────────────────────────────────────────────────────────
# Host port to expose Apache on.
HOST_PORT=8080
# URL path prefix the app is served under (leave empty for root deployment,
# e.g. set to "/hippie" if the app lives at https://example.com/hippie/).
APACHE_PUBLISHED_PATH=

# Override individually only if your paths differ from APACHE_PUBLISHED_PATH:
DJANGO_SCRIPT_NAME=
DJANGO_STATIC_URL=

# ── MCP server ──────────────────────────────────────────────────────────────
# Per-IP request cap on the public MCP endpoint (requests per window, seconds).
HIPPIE_MCP_RATE_LIMIT=60
HIPPIE_MCP_RATE_WINDOW=60
# How many appending reverse-proxy hops sit in front of the mcp container. The
# limiter reads the client IP this many X-Forwarded-For entries from the right,
# because the leftmost entry is caller-supplied and therefore spoofable.
# 2 = host Apache (TLS) + the containerised Apache, which is this stack's layout.
HIPPIE_MCP_TRUSTED_PROXY_HOPS=2
# Public base for deep links back into the website, e.g.
# https://example.com/hippie — unset emits site-relative paths.
HIPPIE_PUBLIC_BASE_URL=

# ── ML splits / Nextflow (worker container only) ────────────────────────────
# Path to the ppi-splitting-pipeline checkout, mounted read-only at
# /opt/pipeline. The default is the `pipeline/` git submodule; override it to
# point at a working tree elsewhere during development.
PIPELINE_PATH=./pipeline
# Path to the Gurobi WLS licence file, mounted read-only at
# /etc/gurobi/gurobi.lic. Keep it OUT of the image and out of git — the
# WLSACCESSID/WLSSECRET pair is recoverable from any layer that held it.
GUROBI_LICENSE_PATH=./secrets/gurobi.lic

# ── ML splits housekeeping (used by `manage.py prune_split_jobs`) ───────────
# Terminal jobs (DONE/FAILED/CANCELLED) older than this are deleted along with
# their zip and any kept work dir. PENDING/RUNNING jobs are never pruned by age.
SPLIT_JOB_RETENTION_DAYS=7
# Seconds without a heartbeat before a RUNNING job is presumed dead and marked
# FAILED. The task beats every 10 s, so this only trips on a killed worker.
SPLIT_JOB_HEARTBEAT_TIMEOUT=900
# Wait quoted on a queued run card before this deployment has finished any run.
# Afterwards the estimate is the median of the last 20 successful ones.
SPLIT_JOB_DEFAULT_RUN_SECONDS=5400
