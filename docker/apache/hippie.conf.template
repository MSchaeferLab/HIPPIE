<VirtualHost *:80>
    ServerAdmin webmaster@localhost
    DocumentRoot /var/www/html

    LimitRequestBody 52428800

    # Static + media + downloads served directly by Apache.
    Alias ${APACHE_PUBLISHED_PATH}/static/    /vol/static/
    Alias ${APACHE_PUBLISHED_PATH}/media/     /vol/media/
    Alias ${APACHE_PUBLISHED_PATH}/downloads/ /vol/downloads/

    <Directory /vol/static/>
        Require all granted
        Options -Indexes
    </Directory>

    <Directory /vol/media/>
        Require all granted
        Options -Indexes
    </Directory>

    <Directory /vol/downloads/>
        Require all granted
        Options -Indexes
        # Force download instead of inline render (large .txt/.tsv release files).
        Header set Content-Disposition attachment
    </Directory>

    # Reverse proxy to gunicorn. Exclude static/media so they hit the
    # Alias above instead of being forwarded.
    ProxyPreserveHost On
    ProxyRequests Off

    ProxyPass        ${APACHE_PUBLISHED_PATH}/static/    !
    ProxyPass        ${APACHE_PUBLISHED_PATH}/media/     !
    ProxyPass        ${APACHE_PUBLISHED_PATH}/downloads/ !

    # MCP endpoint → the hippie_mcp container (uvicorn/ASGI), not gunicorn.
    # ProxyPass rules are evaluated in the order they appear, so this must stay
    # above the catch-all below or the MCP path would be forwarded to the web
    # container. Long timeout because streamable HTTP holds the response open;
    # gzip is off for the same reason — an output filter that buffers would
    # defeat the streaming.
    ProxyPass        ${APACHE_PUBLISHED_PATH}/mcp http://mcp:8001/mcp timeout=300
    ProxyPassReverse ${APACHE_PUBLISHED_PATH}/mcp http://mcp:8001/mcp
    <Location ${APACHE_PUBLISHED_PATH}/mcp>
        SetEnv proxy-sendchunked 1
        SetEnv no-gzip 1
    </Location>

    ProxyPass        ${APACHE_PUBLISHED_PATH}/ http://web:8000/ timeout=120
    ProxyPassReverse ${APACHE_PUBLISHED_PATH}/ http://web:8000/

    # mod_proxy_http already sets X-Forwarded-For; add the proto.
    RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}

    ErrorLog  ${APACHE_LOG_DIR}/error.log
    CustomLog ${APACHE_LOG_DIR}/access.log combined
</VirtualHost>
